# Copy to functions/.env.<your-project-id>  (SMTP_PASS is a secret: firebase functions:secrets:set SMTP_PASS)
MAIN_ADMIN_EMAILS=fc.coordinator@nift.ac.in
APP_URL=https://your-project.web.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=fc.photolab@nift.ac.in
MAIL_FROM="FC Photography Lab <fc.photolab@nift.ac.in>"

# --- Email through Google Sheet + Apps Script (instead of SMTP) ---
# Web app URL from Apps Script → Deploy → New deployment → Web app.
# SHEETS_WEBHOOK_SECRET must equal the SECRET script property in Apps Script.
# When SHEETS_WEBHOOK_URL is set, SMTP is not used (set SMTP_PASS to any value, e.g. "unused").
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
