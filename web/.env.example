# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web).
# These values identify the project; they are not secrets. Security is enforced
# by database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_APP_ID=

# Main Admin on first sign-in (comma-separated). Also hard-coded in database.rules.json.
VITE_MAIN_ADMIN_EMAILS=fc.jodhpur@nift.ac.in

# Google Sheet (Apps Script web app) that sends the emails — see apps-script/README.md
VITE_SHEETS_WEBHOOK_URL=

# Backend: leave empty for the free Spark plan (runs in the browser, protected by
# database.rules.json). Set to "functions" to call deployed Cloud Functions instead.
VITE_BACKEND=

# Only used with VITE_BACKEND=functions. Must match the region in functions/src/core.js
VITE_FUNCTIONS_REGION=asia-south1

# Google sign-in hint (only shows NIFT accounts in the account chooser)
VITE_ALLOWED_DOMAIN=nift.ac.in

# Set to true to use the local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATORS=false
